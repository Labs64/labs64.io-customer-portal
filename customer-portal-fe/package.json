{
  "name": "labs64.io-customer-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:dev": "playwright test --ui --config=playwright.dev.config.ts",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bootstrap-vue-next": "^1.2.2",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "overrides": {
    "vite-plugin-inspect": {
      "vite": "$vite"
    }
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@tsconfig/node26": "^26.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.4",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.0.0",
    "eslint-plugin-playwright": "^2.2.1",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "@playwright/test": "^1.63.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
